DB_URL=jdbc:postgresql://localhost:5432/nevet
DB_USERNAME=nevet
DB_PASSWORD=nevet

# The super-admin's address: on a database with none, startup creates one for it. No password;
# sign in with a one-time code, the console, or the local admin token.
ADMIN_EMAIL=

# The deployment's name (default nevet). It's also the default for BLOG_SITE_NAME, IRC_IDENTITY
# ("<name> IRC Bridge"), KARMA_IMMUNE_SUBJECTS and the user agent; set those only to differ.
# STREAMPACK_NAME=nevet
# Extension jars, and files such as banner.txt, put on the classpath (the image's default).
# STREAMPACK_EXT_DIR=/opt/streampack/ext
# Hangman's word list, one word to a line (default: the list in hangman's jar).
# STREAMPACK_HANGMAN_WORDS=file:/opt/streampack/ext/words/hangman.txt
# A setup tool on the same box opens the console with a super-admin token written here (#209).
# STREAMPACK_LOCAL_ADMIN_TOKEN_FILE=/run/streampack/admin-token
# STREAMPACK_LOCAL_ADMIN_TOKEN_LIFETIME=PT1H

# JWT/session lifetime in hours (default 24)
# 2 weeks: 336
# 30 days: 720
STREAMPACK_JWT_EXPIRATION_HOURS=24

CONSOLE_ENABLED=true
IRC_ENABLED=true
# Identifier exposed via IRC WHOIS/CTCP VERSION (default "<STREAMPACK_NAME> IRC Bridge")
# IRC_IDENTITY="Nevet IRC Bridge"
DISCORD_ENABLED=true
SLACK_ENABLED=true
# Mattermost: enable, then register servers with `mattermost connect <name> <url> <token>`
MATTERMOST_ENABLED=false
STREAMPACK_SECURITY_ENFORCE_EXTERNAL_SECRETS=true

OPENWEATHERMAP_API_KEY=

ANTHROPIC_API_KEY=
AI_ENABLED=false

DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_PERMISSIONS_VALUE=3072

# Subjects karma can't change (default STREAMPACK_NAME)
# KARMA_IMMUNE_SUBJECTS=nevet

CORS_ORIGINS=http://localhost:3000,http://localhost:3003,https://bytecode.news

API_URL=http://localhost:8080
NEXT_PUBLIC_GA_MEASUREMENT_ID=

MAIL_ENABLED=false
MAIL_FROM=noreply@bytecode.news

# Required for GitHub webhook secret encryption at rest
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET_KEY=

# define (#202): how long each dictionary is waited for, and how long one that failed is skipped.
# DICTIONARY_TIMEOUT=3s
# DICTIONARY_BREAK_FOR=15m

# Fetching from other sites: feeds and lookups send USERAGENT (default "<name> (+BASE_URL)");
# page fetches such as chat URL titles send PAGEUSERAGENT (default a current Chrome's).
# A fetch must connect within CONNECTTIMEOUT and finish, body included, within READTIMEOUT.
# STREAMPACK_FETCH_USERAGENT=
# STREAMPACK_FETCH_PAGEUSERAGENT=
# STREAMPACK_FETCH_CONNECTTIMEOUT=5s
# STREAMPACK_FETCH_READTIMEOUT=10s

# Channel logs are split into days in this IANA timezone, the same for every reader (default UTC).
# STREAMPACK_LOG_ZONE=America/New_York

# Uploaded media (posts' recordings, #196): a writable directory; unset or blank turns it off.
# docker-compose.yml sets it to /opt/streampack/media, on the "media" volume, unless set here.
# STREAMPACK_MEDIA_DIR=/opt/streampack/media
# STREAMPACK_MEDIA_MAX_SIZE=100MB
# Every post feed's channel (/blog/rss.xml, /blog/atom.xml, /feed.xml, /feed.atom).
# BLOG_FEED_TITLE defaults to BLOG_SITE_NAME.
# BLOG_FEED_TITLE=
# BLOG_FEED_DESCRIPTION=JVM ecosystem news and community content
# Mermaid blocks in posts and comments drawn as SVG when saved; false leaves them as code.
# BLOG_MERMAID_ENABLED=true
# BLOG_MERMAID_TIMEOUT=5s

# The podcast feed (/podcast.xml): blank title uses BLOG_SITE_NAME; blank fields are left out.
PODCAST_TITLE=
PODCAST_AUTHOR=
PODCAST_IMAGE=
PODCAST_CATEGORY=
PODCAST_EXPLICIT=false
PODCAST_OWNER_EMAIL=

# GitLab project watching is off unless enabled; the key encrypts stored GitLab webhook tokens
GITLAB_ENABLED=false
GITLAB_WEBHOOK_SECRET_KEY=
