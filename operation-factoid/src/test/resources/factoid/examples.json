  {
    "id": "see-chain",
    "title": "An alias can point at another alias",
    "doc": "docs/reference/factoids.md",
    "steps": [
      {"say": "a=placeholder", "reply": "ok, alice: updated a."},
      {"say": "b=placeholder", "reply": "ok, alice: updated b."},
