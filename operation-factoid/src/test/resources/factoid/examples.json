      {"say": "8ball", "oneOf": ["Yes.", "No.", "Maybe.", "Ask me tomorrow.", "Ask me again.", "Ask me again tomorrow.", "It's unclear.", "It's unknowable."], "repeat": 50}
    ]
  },
  {
    "id": "choice-empty",
    "title": "An empty choice says nothing but the period",
    "steps": [
