      {"say": "a.see=b", "reply": "ok, alice: updated a."},
      {"say": "b.see=c", "reply": "ok, alice: updated b."},
      {"say": "a", "reply": "c is final value."}
    ]
  },
  {
    "id": "see-missing",
    "title": "An alias to a missing factoid says nothing",
    "doc": "docs/reference/factoids.md",
    "steps": [
      {"say": "foo=placeholder", "reply": "ok, alice: updated foo."},
      {"say": "foo.see=nonexistent", "reply": "ok, alice: updated foo."},
      {"say": "foo", "silent": true}
    ]
  },
  {
    "id": "see-cycle",
    "title": "Aliases that point at each other say nothing",
    "doc": "docs/reference/factoids.md",
    "steps": [
      {"say": "foo=placeholder", "reply": "ok, alice: updated foo."},
      {"say": "bar=placeholder", "reply": "ok, alice: updated bar."},
      {"say": "foo.see=bar", "reply": "ok, alice: updated foo."},
      {"say": "bar.see=foo", "reply": "ok, alice: updated bar."},
      {"say": "foo", "silent": true}
    ]
  },
  {
    "id": "see-own-attribute",
    "title": "Asking for an alias's attribute reads the alias itself",
    "doc": "docs/reference/factoids.md",
    "steps": [
      {"say": "foo=own text", "reply": "ok, alice: updated foo."},
      {"say": "foo.see=bar", "reply": "ok, alice: updated foo."},
      {"say": "bar=bar text", "reply": "ok, alice: updated bar."},
      {"say": "foo", "reply": "bar is bar text."},
      {"say": "foo.text", "reply": "foo is own text."}
    ]
  },
  {
    "id": "see-removed",
