  {
    "id": "choice",
    "title": "(a|b) picks one choice each time",
    "doc": "docs/how-to/infobot/write-factoid-text.md",
    "steps": [
      {"say": "coin=<reply>(heads|tails)", "reply": "ok, alice: updated coin."},
      {"say": "coin", "oneOf": ["heads.", "tails."], "repeat": 20}
    ]
  },
  {
    "id": "choice-framed",
    "title": "A choice inside framed text",
    "steps": [
      {"say": "greeting=(hello|world)"},
      {"say": "greeting", "oneOf": ["greeting is hello.", "greeting is world."], "repeat": 20}
    ]
  },
  {
    "id": "choices-independent",
    "title": "Each choice group picks on its own",
    "steps": [
      {"say": "combo=<reply>(a|b) and (c|d)"},
      {"say": "combo", "oneOf": ["a and c.", "a and d.", "b and c.", "b and d."], "repeat": 20}
    ]
  },
  {
    "id": "choice-with-argument",
    "title": "A choice and $1 together",
    "doc": "docs/how-to/infobot/write-factoid-text.md",
    "steps": [
      {"say": "farewell=<reply>(hello|goodbye) $1", "reply": "ok, alice: updated farewell."},
      {"say": "farewell world", "oneOf": ["hello world.", "goodbye world."], "repeat": 10}
    ]
  },
  {
    "id": "choices-nested",
    "title": "Choice groups can nest",
    "doc": "docs/how-to/infobot/write-factoid-text.md",
    "steps": [
