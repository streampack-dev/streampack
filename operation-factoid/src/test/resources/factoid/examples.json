  {
    "id": "argument-not-wanted",
    "title": "Words after a selector without $1 are not a lookup",
    "doc": "docs/reference/factoids.md",
    "steps": [
      {"say": "simple=Just a value", "reply": "ok, alice: updated simple."},
      {"say": "simple extra words", "silent": true}
