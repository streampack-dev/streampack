  {
    "id": "lock",
    "title": "An admin locks a factoid; then nobody can change or forget it",
    "doc": "docs/how-to/infobot/manage-factoids.md",
    "steps": [
      {"say": "keepsafe=Not to be lost", "reply": "ok, alice: updated keepsafe."},
      {"say": "keepsafe.lock", "role": "ADMIN", "reply": "ok, keepsafe is now locked."},
      {"say": "keepsafe=Something else", "error": "Factoid 'keepsafe' is locked."},
      {"say": "forget keepsafe", "error": "Factoid 'keepsafe' is locked."},
      {"say": "keepsafe", "reply": "keepsafe is Not to be lost."}
    ]
  },
  {
    "id": "lock-needs-admin",
    "title": "Only an admin can lock a factoid",
    "doc": "docs/reference/factoids.md",
    "steps": [
      {"say": "locktest=value", "reply": "ok, alice: updated locktest."},
      {"say": "locktest.lock", "error": "Lock/unlock requires admin privileges."}
    ]
  },
  {
    "id": "unlock",
    "title": "An admin unlocks a factoid",
    "doc": "docs/how-to/infobot/manage-factoids.md",
    "steps": [
      {"say": "keepsafe=Not to be lost", "reply": "ok, alice: updated keepsafe."},
      {"say": "keepsafe.lock", "role": "ADMIN", "reply": "ok, keepsafe is now locked."},
      {"say": "keepsafe.unlock", "error": "Lock/unlock requires admin privileges."},
      {"say": "keepsafe.unlock", "role": "ADMIN", "reply": "ok, keepsafe is now unlocked."}
    ]
  },
  {
    "id": "locked-refuses-every-change",
    "title": "A locked factoid refuses every way of changing it",
    "steps": [
      {"say": "guarded=original"},
      {"say": "guarded.lock", "role": "ADMIN"},
