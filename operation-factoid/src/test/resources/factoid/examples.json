      {"say": "ref=<reply>(~target|literal)", "reply": "ok, alice: updated ref."},
      {"say": "ref", "oneOf": ["resolved.", "literal."], "repeat": 20}
    ]
  },
  {
    "id": "reference-missing",
    "title": "~name for a missing factoid says nothing",
    "steps": [
      {"say": "ref=<reply>(~nonexistent|fallback)"},
